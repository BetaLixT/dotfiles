+/// Parameters for the Kanagawa wave animation. Local addition; see
+/// `system/tuigreet/README.md` in the dotfiles repo.
+#[derive(Debug, Clone, Deserialize, Serialize, Default, PartialEq)]
+pub struct WaveConfig {
+  /// Colour of the waterline. Accepts `#RRGGBB`, `0xRRGGBB`, or a colour name.
+  #[serde(default)]
+  pub crest_color: Option<String>,
+
+  /// Colour just below the surface.
+  #[serde(default)]
+  pub upper_color: Option<String>,
+
+  /// Colour of mid water.
+  #[serde(default)]
+  pub mid_color: Option<String>,
+
+  /// Colour of deep water.
+  #[serde(default)]
+  pub deep_color: Option<String>,
+
+  /// Colour of the darkest depths.
+  #[serde(default)]
+  pub abyss_color: Option<String>,
+
+  /// Colour of foam on steep crests.
+  #[serde(default)]
+  pub foam_color: Option<String>,
+
+  /// Resting waterline as a fraction of screen height, `0.0`-`1.0`.
+  #[serde(default)]
+  pub level: Option<f32>,
+
+  /// Multiplier on swell amplitude.
+  #[serde(default)]
+  pub amplitude: Option<f32>,
+
+  /// Multiplier on horizontal scroll speed.
+  #[serde(default)]
+  pub speed: Option<f32>,
+
+  /// Strength of the ported ColorMix warp texturing the water. `0.0` gives
+  /// flat depth bands.
+  #[serde(default)]
+  pub warp: Option<f32>,
+
+  /// Surface gradient above which a crest gets foam. Higher means less foam.
+  #[serde(default)]
+  pub foam_slope: Option<f32>,
+}
