* {
    /* Kanagawa colors */
    bg0:     #1F1F28;
    bg1:     #2A2A37;
    bg2:     #363646;
    fg0:     #DCD7BA;
    fg1:     #C8C093;
    fg2:     #727169;
    accent:  #957FB8;
    urgent:  #C34043;
    blue:    #7E9CD8;
    green:   #76946A;

    background-color: transparent;
    text-color: @fg0;
    spacing: 0;
}

window {
    background-color: @bg0;
    border: 2px;
    border-color: @accent;
    border-radius: 8px;
    width: 500px;
}

mainbox {
    padding: 12px;
}

inputbar {
    background-color: @bg1;
    border-radius: 4px;
    padding: 8px 12px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg2;
}

listview {
    lines: 8;
    scrollbar: false;
    padding: 8px 0 0 0;
    fixed-height: false;
}

element {
    padding: 8px 12px;
    border-radius: 4px;
    spacing: 8px;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg0;
}

element normal.active {
    background-color: @bg1;
    text-color: @blue;
}

element selected.normal {
    background-color: @accent;
    text-color: @bg0;
}

element selected.active {
    background-color: @blue;
    text-color: @bg0;
}

element-icon {
    size: 1em;
}

element-text {
    text-color: inherit;
    highlight: bold underline;
}

message {
    padding: 8px 12px;
    background-color: @bg1;
    border-radius: 4px;
}

textbox {
    text-color: @fg1;
}
