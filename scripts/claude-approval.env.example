# Claude phone-approval config.
# Copy to ~/.config/claude-approval.env and fill in. Do NOT commit the real one
# (it holds a token). ~/.config is already outside this repo.

# Your laptop's Tailscale IP + ntfy port. No trailing slash.
NTFY_URL="http://100.x.y.z:8080"

# Topic your phone subscribes to for approval requests.
NTFY_TOPIC="claude-approvals"

# Token from:  sudo ntfy token add claude
NTFY_TOKEN="tk_xxxxxxxxxxxxxxxxxxxxxxxxx"

# How long the hook waits for your tap before falling back to a local prompt.
# Keep this below the PermissionRequest hook "timeout" in ~/.claude/settings.json.
WAIT_SECS=110
