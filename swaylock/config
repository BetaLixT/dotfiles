# Kanagawa theme for swaylock

# Background
color=1F1F28

# Ring
ring-color=957FB8
ring-ver-color=7E9CD8
ring-wrong-color=C34043
ring-clear-color=76946A

# Key highlight
key-hl-color=98BB6C
bs-hl-color=E46876

# Inside circle
inside-color=1F1F28
inside-ver-color=1F1F28
inside-wrong-color=1F1F28
inside-clear-color=1F1F28

# Line (between ring and inside)
line-color=1F1F28
line-ver-color=1F1F28
line-wrong-color=1F1F28
line-clear-color=1F1F28

# Separator (between ring and inside)
separator-color=1F1F28

# Text
text-color=DCD7BA
text-ver-color=7E9CD8
text-wrong-color=C34043
text-clear-color=76946A

# Indicator
indicator-radius=100
indicator-thickness=10

# Behavior
ignore-empty-password
show-failed-attempts

# Font
font=SFMono Nerd Font
font-size=24
