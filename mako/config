# Mako config - Kanagawa theme

# Appearance
font=monospace 11
background-color=#1F1F28
text-color=#DCD7BA
border-color=#957FB8
border-radius=5
border-size=2
padding=12
width=320
max-visible=3

# Position
anchor=top-right
margin=10

# Behavior
default-timeout=5000
group-by=app-name

# Low urgency
[urgency=low]
background-color=#1F1F28
border-color=#54546D
default-timeout=3000

# Normal urgency
[urgency=normal]
background-color=#1F1F28
border-color=#957FB8

# Critical urgency (battery warnings)
[urgency=critical]
background-color=#C34043
text-color=#ffffff
border-color=#E82424
default-timeout=0
